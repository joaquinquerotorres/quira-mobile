# Quira Mobile - Variables de entorno
# Copia este archivo a .env y configura los valores para tu entorno.

# URL base de la API del backend (sin barra final)
# Ejemplos: https://api.quira.app/api | http://localhost:8000/api
VITE_API_URL=/api

# Clave de Google Maps para autocompletado de direcciones (opcional)
# Obtener en: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_KEY=

# Firebase (web config)
# Nota: estos valores NO son una "service account" ni una private key.
# Se usan para inicializar Firebase web SDK (Analytics, etc.).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
